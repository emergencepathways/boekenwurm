{
  "name": "@boekenwurm/web",
  "version": "0.1.0",
  "description": "Boekenwurm: read Dutch books you own at your level. Installable web app (React + Vite + Supabase).",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p . && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p .",
    "test": "node --test \"test/**/*.test.ts\"",
    "icons": "node scripts/icons.mjs",
    "e2e": "node test/e2e.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "@tesseract.js-data/nld": "^1.0.0",
    "jszip": "^3.10.1",
    "pdfjs-dist": "^6.5.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tesseract.js": "^7.0.0",
    "ts-fsrs": "^5.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "typescript": "^5.9.0",
    "vite": "^8.1.0",
    "vite-plugin-pwa": "^2.0.0"
  }
}
