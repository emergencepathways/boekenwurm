{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client", "vite-plugin-pwa/client", "node"],
    "paths": {
      "@boekenwurm/engine": ["../../packages/engine/src/index.ts"],
      "@boekenwurm/dutch": ["../../packages/dutch/src/lemma.ts"],
      "@boekenwurm/ai": ["../../packages/ai/src/index.ts"],
      "@boekenwurm/books": ["../../packages/books/src/index.ts"],
      "@data/*": ["../../data/*"]
    }
  },
  "include": ["src", "test", "vite.config.ts"]
}
